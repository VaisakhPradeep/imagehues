---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const id = 241;
const primaryHue = "Emerald";
const tags = ["Emerald","Sand","Dark","Moody"];
const palette = [{"rgb":[3,97,79],"hex":"#03614f"},{"rgb":[22,40,38],"hex":"#162826"},{"rgb":[196,179,155],"hex":"#c4b39b"},{"rgb":[121,99,102],"hex":"#796366"}];
const tier = "public";
const imageUrl = "/unsplash_images/img241.jpg";

function rgbToCss(rgb: number[]) {
  return `rgb(${rgb[0]}, ${rgb[1]}, ${rgb[2]})`;
}
---

<BaseLayout
  title="Emerald color palette — #03614f #162826 #c4b39b #796366 | ImageHues"
  description="Explore this emerald color palette extracted from a curated photo. Emerald, Sand, Dark, Moody tones. Click to copy hex codes."
  canonicalPath="/palette/241/"
  imageUrl={imageUrl}
>
  <div class="mx-auto max-w-[1200px] px-6 max-[480px]:px-4">
    <div class="py-16 max-lg:py-12">
      <h1
        class="mb-8 font-sans text-[48px] leading-[56px] font-medium text-text-primary max-md:text-[36px] max-md:leading-[44px] max-[480px]:text-[28px] max-[480px]:leading-[36px]"
      >
        Emerald color palette
      </h1>

      <div class="mx-auto max-w-[800px]">
        <div
          class="group relative m-0 w-auto rounded-[18px] bg-surface p-2.5 shadow-card"
        >
          <img
            src={imageUrl}
            alt="Emerald color palette from curated photo"
            width="800"
            height="600"
            loading="eager"
            decoding="async"
            class="w-full rounded-[6px]"
          />
          <div class="color-panel flex items-center justify-center gap-8 px-8 py-6 max-[480px]:gap-4 max-[480px]:px-4 max-[480px]:py-4">
            {palette.map((color) => (
              <div class="flex flex-col items-center gap-2">
                <div
                  class="color h-12 w-12 cursor-pointer rounded-full shadow-md transition-transform hover:scale-110 max-[480px]:h-10 max-[480px]:w-10"
                  style={`background-color: ${rgbToCss(color.rgb)}`}
                  onclick="onColorClick(event)"
                  data-hex={color.hex}
                >
                </div>
                <span class="text-sm font-mono text-text-secondary">{color.hex}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  function onColorClick(event) {
    const hex = event.currentTarget.getAttribute('data-hex');
    navigator.clipboard.writeText(hex);
    
    const originalBg = event.currentTarget.style.backgroundColor;
    event.currentTarget.style.transform = 'scale(1.2)';
    setTimeout(() => {
      event.currentTarget.style.transform = 'scale(1)';
    }, 200);
  }
</script>
